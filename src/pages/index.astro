---
import SocialList from "@/components/SocialList.astro";
import PostPreview from "@/components/blog/PostPreview.astro";
import PageLayout from "@/layouts/Base.astro";
import { getAllPosts, sortMDByDate } from "@/utils";

const MAX_POSTS = 10;
const allPosts = await getAllPosts();
const allPostsByDate = sortMDByDate(allPosts).slice(0, MAX_POSTS);
const meta = {
	description: "Notes on software engineering, machine learning, and the systems and ideas around them.",
	title: "Software engineering and machine learning notes",
	structuredData: {
		"@context": "https://schema.org",
		"@type": "WebSite",
		name: "h11r.at",
		url: Astro.site?.href,
		description: "Notes on software engineering, machine learning, and the systems and ideas around them.",
	},
};
---

<PageLayout meta={meta}>
	<section>
		<h1 class="title mb-6">Hello World!</h1>
		<p class="mb-4">
			Random musings on machine learning, software engineering and things in-between.
		</p>
		<SocialList />
	</section>
	<section aria-label="Blog post list" class="mt-16">
		<h2 class="title mb-4 text-xl">Posts</h2>
		<ul class="space-y-4">
			{
				allPostsByDate.map((p) => (
					<li class="flex flex-col gap-x-2 sm:flex-row">
						<PostPreview post={p} />
					</li>
				))
			}
		</ul>
	</section>
</PageLayout>
