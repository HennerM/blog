---
import { Image } from "astro:assets";

import { menuLinks, siteConfig } from "@/site-config";

const url = new URL(Astro.request.url);
---

<header class="group relative mb-14 flex items-center sm:ps-[4.5rem]" id="main-header">
	<div class="flex sm:flex-col">
		<a
			aria-current={url.pathname === "/" ? "page" : false}
			class="group inline-flex items-center sm:relative sm:inline-block"
			href="/"
		>
			<Image
				alt={`${siteConfig.title} home`}
				class="h-16 w-16 grayscale transition-[filter] duration-200 group-hover:[filter:invert(50%)_sepia(25%)_saturate(992%)_hue-rotate(116deg)_brightness(92%)_contrast(89%)] dark:grayscale-0 dark:group-hover:[filter:brightness(1.1)_hue-rotate(15deg)] sm:absolute sm:start-[-5rem] sm:me-0 sm:h-20 sm:w-20"
				height={1024}
				src="/icon.svg"
				width={1024}
			/>
		</a>
		<nav
			aria-label="Main menu"
			class="z-auto mt-5 flex-row items-center divide-x divide-dashed divide-accent rounded-none bg-transparent py-0 shadow-none backdrop-blur-none sm:mt-7"
			id="navigation-menu"
		>
			{
				menuLinks.map((link) => (
					<a
						aria-current={url.pathname === link.path ? "page" : false}
						class="px-4 py-4 sm:py-0 sm:hover:underline"
						data-astro-prefetch
						href={link.path}
					>
						{link.title}
					</a>
				))
			}
		</nav>
	</div>
</header>
